# TaskOrbit — Part 1 environment variables.
# Copy to .env.local for local dev (never commit .env.local).
# Values come from your Supabase project: Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# No SUPABASE_SERVICE_ROLE_KEY is used anywhere in Part 1. All database
# access goes through the logged-in user's session (RLS enforced), plus the
# SECURITY DEFINER RPCs create_workspace / accept_invitation. Do not add a
# service-role key to the client or to .env.local unless a later part
# genuinely needs server-side admin access — and then keep it server-only
# (never NEXT_PUBLIC_).

# --- TaskOrbit AI (Part 3) — server-only, never NEXT_PUBLIC_, never in the
# browser bundle, never committed. Leave blank to run without AI: the
# /dashboard/ai page then shows a clean "not configured" state.
# GEMINI_API_KEY: Google AI Studio API key for the Gemini model below.
# GEMINI_MODEL: low-cost Gemini text model (default gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Daily scheduler (Part 3) — protects /api/cron/daily. The route
# returns 401 without the exact `Authorization: Bearer <secret>` header.
# Generate one with: openssl rand -hex 32
# (already set in .env.local; the value here is a placeholder only.)
CRON_SECRET=
